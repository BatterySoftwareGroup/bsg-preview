---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import { getCollection } from 'astro:content';
// newest first ("period" starts with YYYY.MM)
const projects = (await getCollection('projects')).map((p) => p.data).sort((a, b) => b.period.localeCompare(a.period));
---
<Layout title="Projects">
<Container title="Projects">
  {[['ongoing', 'Ongoing'], ['completed', 'Completed']].map(([s, label]) => (
    <section class="mt-10">
      <h2 class="text-xl font-semibold">{label}</h2>
      <ul class="mt-4 divide-y divide-slate-200 dark:divide-slate-700">
        {projects.filter((p) => p.status === s).map((p) => (
          <li class="py-3">
            <p class="font-medium">{p.title}</p>
            <p class="text-sm text-slate-500">{p.sponsor} · {p.period}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Container>
</Layout>
