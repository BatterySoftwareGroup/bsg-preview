---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import NewsTag from '../../components/NewsTag.astro';
import { getCollection, render } from 'astro:content';
// Each post's body is shown inline; there are no detail pages.
const posts = await Promise.all(
  (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date).map(async (p) => ({ ...p, Content: (await render(p)).Content })),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="News">
<Container title="News">
  <ul class="divide-y divide-slate-200 dark:divide-slate-700">
    {posts.map((p) => (
      <li class="grid gap-x-6 gap-y-1 py-5 sm:grid-cols-[8rem_1fr]">
        <div class="flex items-center gap-3 sm:flex-col sm:items-start"><time class="font-mono text-sm text-slate-500">{p.data.date.toISOString().slice(0, 10)}</time><NewsTag category={p.data.category} /></div>
        <div>
          <p class="font-semibold">{p.data.title}</p>
          <div class="prose prose-sm prose-slate mt-1 max-w-none dark:prose-invert"><p.Content /></div>
          {p.data.image && <img src={`${base}${p.data.image}`} alt="" class="mt-3 max-w-md rounded-xl" loading="lazy" />}
        </div>
      </li>
    ))}
  </ul>
</Container>
</Layout>
