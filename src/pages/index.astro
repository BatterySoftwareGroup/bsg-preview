---
// Home, v2: SD Kang Lab layout — hero, then main column (about, recruiting, research, publications)
// with an Announcements sidebar. Hero buttons scroll to sections on this page (NEMO-style anchors).
import Layout from '../layouts/Layout.astro';
import PubItem from '../components/PubItem.astro';
import NewsTag from '../components/NewsTag.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topics = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 5);
const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year).slice(0, 3);
const photos = (await getCollection('gallery')).map((g) => g.data).sort((a, b) => +b.date - +a.date).slice(0, 4);
const h2 = 'text-2xl font-bold text-ink dark:text-white';
const more = 'text-sm font-medium text-blue hover:underline';
const poster = SITE.heroImage && `${base}${SITE.heroImage}`;
---
<Layout>
  <!-- Hero: first screen before scrolling — background media + mission + buttons -->
  <section class="relative flex min-h-[55vh] items-center overflow-hidden bg-gradient-to-br from-ink via-navy to-blue text-white">
    {SITE.heroVideo
      ? <video class="absolute inset-0 h-full w-full object-cover" data-src={`${base}${SITE.heroVideo}`} poster={poster} autoplay muted loop playsinline preload="none" />
      : poster ? <img class="absolute inset-0 h-full w-full object-cover" src={poster} alt="" />
      : <HeroCanvas />}
    <!-- dark gradient so text stays legible over any media -->
    <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-navy/40 to-transparent"></div>
    <div class="relative mx-auto w-full max-w-6xl px-4 py-16 md:py-24 lg:px-8" data-stagger>
      <p class="font-mono text-sm font-extrabold tracking-widest text-sky uppercase">{SITE.fullName} · {SITE.affiliation}</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-6xl">{SITE.mission}</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-200 md:text-xl">{SITE.tagline}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#join" class="rounded-full bg-white px-6 py-2.5 font-semibold text-navy hover:bg-sky hover:text-white">Join us</a>
        <a href="#research" class="rounded-full border border-white/60 px-6 py-2.5 font-semibold hover:bg-white/10">Our research ↓</a>
      </div>
    </div>
  </section>
  <script is:inline>
    // Load the hero video only on wide screens without data-saver; others keep the poster image.
    const v = document.querySelector('video[data-src]');
    if (v && matchMedia('(min-width: 768px)').matches && !navigator.connection?.saveData) v.src = v.dataset.src;
  </script>

  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-14 lg:grid-cols-[1fr_18rem] lg:px-8 lg:py-16">
    <div class="space-y-16">
      <section id="about" class="reveal scroll-mt-24">
        <h2 class={h2}>About</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-700 dark:text-slate-300">{SITE.about}</p>
      </section>

      <section id="join" class="reveal scroll-mt-24 rounded-2xl border-l-4 border-sky bg-sky/5 p-6 md:p-8">
        <h2 class={h2}>Interested in working with us?</h2>
        <p class="mt-3 text-slate-700 dark:text-slate-300">{SITE.recruiting}</p>
        <a href={`${base}/join`} class="mt-5 inline-block rounded-full bg-blue px-5 py-2 text-sm font-semibold text-white hover:bg-navy">Openings & how to apply →</a>
      </section>

      <section id="research" class="scroll-mt-24">
        <div class="reveal flex items-baseline justify-between"><h2 class={h2}>Research Themes</h2><a href={`${base}/research`} class={more}>More →</a></div>
        <div class="mt-6 divide-y divide-slate-200 dark:divide-slate-700" data-stagger>
          {topics.map((t) => (
            <a href={`${base}/research/${t.id}`} class="group flex items-center gap-5 py-4">
              {(t.data.cover ?? t.data.image) && <img src={`${base}${t.data.cover ?? t.data.image}`} alt="" class="h-20 w-28 shrink-0 rounded-lg object-contain" />}
              <div>
                <p class="font-bold tracking-wide text-ink uppercase group-hover:text-blue dark:text-white">{t.data.title}</p>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{t.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section id="publications" class="reveal scroll-mt-24">
        <div class="flex items-baseline justify-between"><h2 class={h2}>Recent Publications</h2><a href={`${base}/publications`} class={more}>All publications →</a></div>
        <ul class="mt-5 space-y-5">{pubs.map((p) => <PubItem p={p.data} id={p.id} />)}</ul>
      </section>
    </div>

    <!-- Announcements sidebar (SD Kang Lab pattern) -->
    <aside class="reveal lg:sticky lg:top-24 lg:self-start">
      <h2 class="text-xl font-bold text-ink dark:text-white">Announcements</h2>
      <ul class="mt-4 space-y-5">
        {news.map((n) => (
          <li>
            <p class="flex items-center gap-2"><time class="font-mono text-xs text-slate-500">{n.data.date.toISOString().slice(0, 10)}</time><NewsTag category={n.data.category} /></p>
            <p class="mt-1 font-semibold text-blue">{n.data.title}</p>
          </li>
        ))}
      </ul>
      <a href={`${base}/news`} class={`mt-5 inline-block ${more}`}>All news »</a>
    </aside>
  </div>

  <section class="bg-slate-50 dark:bg-slate-800/50">
    <div class="mx-auto max-w-6xl px-4 py-14 lg:px-8">
      <div class="reveal flex items-baseline justify-between"><h2 class={h2}>Gallery</h2><a href={`${base}/gallery`} class={more}>View all →</a></div>
      <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4" data-stagger>
        {photos.map((g) => <a href={`${base}/gallery`}><img src={`${base}${g.image}`} alt={g.caption} class="aspect-[3/2] w-full rounded-xl object-cover" loading="lazy" /></a>)}
      </div>
    </div>
  </section>
</Layout>
