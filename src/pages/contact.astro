---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import { SITE } from '../site';
const map = `https://www.google.com/maps?q=${encodeURIComponent(SITE.mapQuery)}&output=embed`;
---
<Layout title="Contact">
<Container title="Contact">
  <div class="grid gap-10 md:grid-cols-2">
    <div class="space-y-6">
      <div>
        <h2 class="text-xl font-bold text-navy dark:text-white">{SITE.fullName}</h2>
        <p class="text-slate-500">{[SITE.fullNameKo, SITE.department, SITE.affiliationFull].filter(Boolean).join(' · ')}</p>
      </div>
      <dl class="space-y-3">
        <div><dt class="text-sm font-semibold text-slate-500">Address</dt><dd>{SITE.address}</dd>{SITE.addressKo && <dd class="text-sm text-slate-500">{SITE.addressKo}</dd>}</div>
        <div><dt class="text-sm font-semibold text-slate-500">Office</dt><dd>{SITE.office}</dd></div>
        <div><dt class="text-sm font-semibold text-slate-500">Email</dt><dd><a href={`mailto:${SITE.email}`} class="text-blue hover:underline">{SITE.email}</a></dd></div>
        {SITE.phone && <div><dt class="text-sm font-semibold text-slate-500">Phone</dt><dd>{SITE.phone}</dd></div>}
      </dl>
      <div class="rounded-2xl border-l-4 border-sky bg-slate-50 p-5 dark:bg-slate-800">
        <h2 class="font-bold text-navy dark:text-white">Join us</h2>
        <p class="mt-2 text-slate-700 dark:text-slate-300">{SITE.recruiting}</p>
        <a href={`mailto:${SITE.email}`} class="mt-4 inline-block rounded-full bg-blue px-5 py-2 text-sm font-semibold text-white hover:bg-navy">Email the professor</a>
      </div>
    </div>
    <iframe src={map} class="min-h-80 w-full rounded-2xl border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map"></iframe>
  </div>
</Container>
</Layout>
