---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import PubItem from '../../components/PubItem.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('research')).map((t) => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props;
const { Content } = await render(t);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const related = (await getCollection('publications')).filter((p) => t.data.related.includes(p.id)).sort((a, b) => b.data.year - a.data.year);
const topics = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title={t.data.title}>
<Container>
  <!-- Topic tabs: jump between research areas without going back to the list -->
  <nav class="-mx-4 mb-8 flex gap-2 overflow-x-auto border-b border-slate-200 px-4 pb-4 whitespace-nowrap sm:mx-0 sm:flex-wrap sm:px-0 dark:border-slate-700" aria-label="Research areas">
    {topics.map((x, i) => (
      <a href={`${base}/research/${x.id}`} class:list={['rounded-full px-4 py-1.5 text-sm font-medium', x.id === t.id ? 'bg-blue text-white' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800']}>
        <span class="mr-1.5 font-mono text-xs opacity-70">{String(i + 1).padStart(2, '0')}</span>{x.data.title}
      </a>
    ))}
  </nav>
  <h1 class="mt-2 text-3xl font-bold text-navy md:text-4xl dark:text-white">{t.data.title}</h1>
  <p class="mt-2 text-lg text-slate-600 dark:text-slate-300">{t.data.summary}</p>
  {t.data.image && <img src={`${base}${t.data.image}`} alt="" class="mt-8 w-full rounded-2xl" />}
  <article class="prose prose-slate mt-8 max-w-3xl dark:prose-invert"><Content /></article>
  {related.length > 0 && <>
    <h2 class="mt-10 text-xl font-bold text-navy dark:text-white">Related Publications</h2>
    <ul class="mt-4 max-w-3xl space-y-4">{related.map((p) => <PubItem p={p.data} id={p.id} />)}</ul>
  </>}
</Container>
</Layout>
