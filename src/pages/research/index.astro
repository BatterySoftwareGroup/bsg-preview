---
// Research v2 (SD Kang Lab pattern): Themes as rows (image + uppercase title + one line),
// with the number of papers per theme (publications.yaml `themes`).
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topics = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const pubs = await getCollection('publications');
const count = (id: string) => pubs.filter((p) => p.data.themes.some((x) => x.id === id)).length;
const h2 = 'text-2xl font-bold text-ink dark:text-white';
---
<Layout title="Research">
<Container title="Research">
  <h2 class={h2}>Research Themes</h2>
  <div class="mt-4 divide-y divide-slate-200 dark:divide-slate-700" data-stagger>
    {topics.map((t) => (
      <a href={`${base}/research/${t.id}`} class="group flex flex-col gap-5 py-6 sm:flex-row sm:items-center">
        {(t.data.cover ?? t.data.image) && <img src={`${base}${t.data.cover ?? t.data.image}`} alt="" class="aspect-[3/2] w-full shrink-0 rounded-xl bg-slate-50 object-contain sm:w-56 dark:bg-slate-800" />}
        <div>
          <p class="text-lg font-bold tracking-wide text-ink uppercase group-hover:text-blue dark:text-white">{t.data.title}</p>
          <p class="mt-1 text-slate-600 dark:text-slate-300">{t.data.summary}</p>
          <p class="mt-2 text-sm font-medium text-blue">Read more · {count(t.id)} publications →</p>
        </div>
      </a>
    ))}
  </div>

</Container>
</Layout>
