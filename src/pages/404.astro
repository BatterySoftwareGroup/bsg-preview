---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Page not found">
<Container>
  <p class="font-mono text-6xl font-extrabold text-sky">404</p>
  <h1 class="mt-2 text-2xl font-bold">Page not found</h1>
  <p class="mt-2 text-slate-500">The page you are looking for does not exist or has moved.</p>
  <a href={`${base}/`} class="mt-6 inline-block rounded-full bg-blue px-5 py-2 text-sm font-semibold text-white hover:bg-navy">Back to home</a>
</Container>
</Layout>
