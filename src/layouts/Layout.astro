---
import '../styles/global.css';
import { SITE } from '../site';
import Logo from '../components/Logo.astro';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// [href, label, children?] — items with children open a dropdown (desktop) / indented list (mobile).
const nav: [string, string, [string, string][]?][] = [
  ['/', 'Home'],
  ['/professor', 'People', [['/professor', 'Professor'], ['/members', 'Members'], ['/alumni', 'Alumni']]],
  ['/research', 'Research', [['/research', 'Themes'], ['/projects', 'Projects']]],
  ['/publications', 'Publications'],
  ['/news', 'News', [['/news', 'News'], ['/gallery', 'Gallery']]],
  ['/join', 'Join us'],
  ['/contact', 'Contact'],
];
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const on = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const active = ([href, , kids]: (typeof nav)[number]) => on(href) || !!kids?.some(([h]) => on(h));
const flat = nav.flatMap(([href, label, kids]) => kids ?? [[href, label]]);
const partner = SITE.partnerLogo && `${base}${SITE.partnerLogo}`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <title>{title ? `${title} | ${SITE.name}` : `${SITE.name} · ${SITE.fullName}`}</title>
    <meta name="description" content={SITE.tagline} />
    {SITE.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/sun-typeface/SUIT@2.0.5/fonts/variable/woff2/SUIT-Variable.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@800&display=swap" />
    <meta property="og:title" content={title ? `${title} | ${SITE.name}` : SITE.fullName} />
    <meta property="og:description" content={SITE.tagline} />
    <meta property="og:image" content={new URL(`${base}/og.png`, Astro.site)} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-slate-800 dark:bg-slate-900 dark:text-slate-100">
    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-700 dark:bg-slate-900/90">
      <div class="mx-auto flex max-w-6xl items-center gap-6 px-4 py-3 lg:px-8">
        {partner && <a href={SITE.affiliationUrl} target="_blank" rel="noopener" class="shrink-0"><img src={partner} alt={SITE.affiliation} class="h-7 md:h-8" /></a>}
        <a href={`${base}/`} class:list={['flex items-center gap-3', partner && 'border-l border-slate-300 pl-4 dark:border-slate-600']}><Logo class="h-8 md:h-9" /><span class="hidden text-lg font-semibold text-ink sm:inline dark:text-white">{SITE.fullName}</span></a>
        <nav class="ml-auto hidden gap-7 text-[15px] font-medium lg:flex">
          {nav.map((item) => {
            const [href, label, kids] = item;
            return (
              <div class="group relative">
                <a href={`${base}${href}`} class:list={['py-2 hover:text-blue', active(item) && 'text-blue']}>{label}{kids && <span class="ml-1 text-[10px] opacity-60">▾</span>}</a>
                {kids && (
                  <div class="invisible absolute left-1/2 top-full z-30 min-w-40 -translate-x-1/2 rounded-xl border border-slate-200 bg-white p-2 opacity-0 shadow-lg transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 dark:border-slate-700 dark:bg-slate-900">
                    {kids.map(([h, l]) => <a href={`${base}${h}`} class:list={['block rounded-lg px-3 py-2 whitespace-nowrap hover:bg-slate-100 dark:hover:bg-slate-800', on(h) && 'text-blue']}>{l}</a>)}
                  </div>
                )}
              </div>
            );
          })}
        </nav>
        <button id="menu-open" class="ml-auto p-2 lg:hidden" aria-label="Open menu" aria-controls="drawer" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </div>
    </header>

    <!-- Mobile menu: full-screen panel that fades/slides in (pattern used by Samsung SDI, LG ES, Apple, Tesla). -->
    <aside id="drawer" class="invisible fixed inset-0 z-40 flex -translate-y-3 flex-col bg-white opacity-0 transition-[opacity,transform,visibility] duration-300 lg:hidden dark:bg-slate-900" aria-hidden="true">
      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-3 dark:border-slate-700">
        <Logo class="h-7" />
        <button id="menu-close" class="p-2" aria-label="Close menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <nav class="flex flex-col overflow-y-auto px-5 py-2 text-xl">
        {nav.map((item) => {
          const [href, label, kids] = item;
          return kids ? (
            <div class="border-b border-slate-100 py-3 dark:border-slate-800">
              <p class:list={['font-medium', active(item) && 'text-blue']}>{label}</p>
              {kids.map(([h, l]) => <a href={`${base}${h}`} class:list={['block py-1.5 pl-4 text-lg text-slate-600 dark:text-slate-300', on(h) && 'text-blue']}>{l}</a>)}
            </div>
          ) : <a href={`${base}${href}`} class:list={['border-b border-slate-100 py-4 font-medium dark:border-slate-800', on(href) && 'text-blue']}>{label}</a>;
        })}
      </nav>
      {partner && <a href={SITE.affiliationUrl} target="_blank" rel="noopener" class="mt-auto mb-6 self-start px-5"><img src={partner} alt={SITE.affiliation} class="h-8" /></a>}
    </aside>
    <script>
      const drawer = document.getElementById('drawer')!, open = document.getElementById('menu-open')!;
      const set = (on: boolean) => {
        for (const c of ['invisible', 'opacity-0', '-translate-y-3']) drawer.classList.toggle(c, !on);
        document.body.classList.toggle('overflow-hidden', on);
        drawer.setAttribute('aria-hidden', String(!on)); open.setAttribute('aria-expanded', String(on));
      };
      open.onclick = () => set(true);
      document.getElementById('menu-close')!.onclick = () => set(false);
      addEventListener('keydown', (e) => e.key === 'Escape' && set(false));

      // Scroll-reveal: play once when an element enters the viewport (CSS in global.css).
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -10%' });
      document.querySelectorAll('.reveal, [data-stagger]').forEach((el) => io.observe(el));
    </script>

    <main class="flex-1"><slot /></main>

    <footer class="bg-ink text-slate-300">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3 lg:px-8">
        <div>
          <div class="flex items-center gap-4">{partner && <a href={SITE.affiliationUrl} target="_blank" rel="noopener"><img src={partner} alt={SITE.affiliation} class="h-8 brightness-0 invert" /></a>}<Logo full class="h-14" /></div>
          <p class="mt-4 text-lg font-bold text-white">{SITE.fullName}</p>
          {SITE.fullNameKo && <p>{SITE.fullNameKo}</p>}
          <p class="mt-2 text-sm">{SITE.department && `${SITE.department}, `}{SITE.affiliationFull}</p>
        </div>
        <div class="text-sm">
          <p>{SITE.address}</p>
          <a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a>
        </div>
        <nav class="flex flex-col gap-1 text-sm md:items-end">
          {flat.map(([href, label]) => <a href={`${base}${href}`} class="hover:text-white">{label}</a>)}
          {SITE.github && <a href={SITE.github} class="hover:text-white">GitHub</a>}
        </nav>
      </div>
      <p class="border-t border-slate-700 py-4 text-center text-xs text-slate-500">© {new Date().getFullYear()} {SITE.name}, {SITE.affiliation}</p>
    </footer>
  </body>
</html>
