---
import '../styles/global.css';
import { SITE } from '../site';
import Logo from '../components/Logo.astro';
import { getCollection } from 'astro:content';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// v3: one long home page. Menu items are its sections; from other pages they lead back to home#section.
// Sub-items replace the old per-section "On this page" indexes; ones pointing into a folded panel open it.
const themes = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order).map((t) => [`theme-${t.id}`, t.data.short] as [string, string]);
const nav: [string, string, [string, string][]][] = [
  ['about', 'About', []],
  ['research', 'Research', [...themes, ['projects-more', 'Projects']]],
  ['people', 'People', [['people', 'Professor'], ['people-members', 'Graduate Students'], ['people-alumni', 'Alumni']]],
  ['publications', 'Publications', [['publications', 'Recent'], ['pubs-all', 'All publications']]],
  ['gallery', 'Gallery', []],
  ['join', 'Join & Contact', [['join', 'Join us'], ['apply', 'How to apply'], ['contact', 'Contact']]],
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <title>{title ? `${title} | ${SITE.name}` : `${SITE.name} · ${SITE.fullName}`}</title>
    <meta name="description" content={SITE.tagline} />
    {SITE.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/sun-typeface/SUIT@2.0.5/fonts/variable/woff2/SUIT-Variable.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap" />
    <meta property="og:title" content={title ? `${title} | ${SITE.name}` : SITE.fullName} />
    <meta property="og:description" content={SITE.tagline} />
    <meta property="og:image" content={new URL(`${base}/og.png`, Astro.site)} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-slate-800 dark:bg-slate-900 dark:text-slate-100">
    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-700 dark:bg-slate-900/90">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 lg:px-8">
        <a href={`${base}/`} class="flex items-center gap-3"><Logo class="h-8 md:h-9" /><span class="hidden text-lg font-semibold text-ink sm:inline dark:text-white">{SITE.fullName}</span></a>
        <nav class="page-toc ml-auto hidden gap-7 text-[15px] font-medium lg:flex" aria-label="Sections">
          {nav.map(([id, label, sub]) => (
            <div class="group relative">
              <a href={`${base}/#${id}`} data-toc={id} class="block py-5 hover:text-blue">{label}</a>
              {sub.length > 0 && (
                <div class="invisible absolute top-full left-1/2 -translate-x-1/2 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                  <div class="flex min-w-48 flex-col rounded-xl border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-800">
                    {sub.map(([sid, sl]) => <a href={`${base}/#${sid}`} class="rounded-lg px-3 py-2 text-sm whitespace-nowrap text-slate-600 hover:bg-slate-100 hover:text-blue dark:text-slate-300 dark:hover:bg-slate-700">{sl}</a>)}
                  </div>
                </div>
              )}
            </div>
          ))}
        </nav>
        <button id="menu-open" class="ml-auto p-2 lg:hidden" aria-label="Open menu" aria-controls="drawer" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </div>
    </header>

    <!-- Mobile menu: full-screen panel that fades/slides in (pattern used by Samsung SDI, LG ES, Apple, Tesla). -->
    <aside id="drawer" class="invisible fixed inset-0 z-40 flex -translate-y-3 flex-col bg-white opacity-0 transition-[opacity,transform,visibility] duration-300 lg:hidden dark:bg-slate-900" aria-hidden="true">
      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-3 dark:border-slate-700">
        <Logo class="h-7" />
        <button id="menu-close" class="p-2" aria-label="Close menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <nav class="flex flex-col overflow-y-auto px-5 py-2 text-xl">
        {nav.map(([id, label, sub]) => (
          <div class="border-b border-slate-100 py-3 dark:border-slate-800">
            <a href={`${base}/#${id}`} class="block py-1 font-medium">{label}</a>
            {sub.length > 0 && <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-[15px] text-slate-500 dark:text-slate-400">{sub.map(([sid, sl]) => <a href={`${base}/#${sid}`} class="py-1 hover:text-blue">{sl}</a>)}</div>}
          </div>
        ))}
      </nav>
    </aside>
    <script>
      const drawer = document.getElementById('drawer')!, open = document.getElementById('menu-open')!;
      const set = (on: boolean) => {
        for (const c of ['invisible', 'opacity-0', '-translate-y-3']) drawer.classList.toggle(c, !on);
        document.body.classList.toggle('overflow-hidden', on);
        drawer.setAttribute('aria-hidden', String(!on)); open.setAttribute('aria-expanded', String(on));
      };
      open.onclick = () => set(true);
      document.getElementById('menu-close')!.onclick = () => set(false);
      addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
      drawer.addEventListener('click', (e) => (e.target as HTMLElement).closest('a') && set(false));

      // Go to #id on this page, first opening a folded target (<details> theme, or a [data-expand] panel).
      const reveal = (id: string, behavior: ScrollBehavior = 'smooth') => {
        const t = document.getElementById(id);
        if (!t) return;
        if (t instanceof HTMLDetailsElement) t.open = true;
        const panel = t.hidden ? t : t.closest<HTMLElement>('[hidden]');
        if (panel) document.querySelector<HTMLElement>(`[data-expand="${panel.id}"][aria-expanded="false"]`)?.click();
        t.scrollIntoView({ behavior });
        // Images in a just-opened panel load mid-scroll and shift the target: settle on it once the scroll ends.
        const fix = () => t.scrollIntoView({ behavior: 'instant' });
        addEventListener('scrollend', fix, { once: true });
        setTimeout(() => removeEventListener('scrollend', fix), 2000);
      };
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]');
        if (!a || a.pathname !== location.pathname || !a.hash) return;
        e.preventDefault();
        history.pushState(null, '', a.hash);
        (document.activeElement as HTMLElement)?.blur(); // let the header dropdown close
        reveal(a.hash.slice(1));
      });
      // Arriving from another page at /#id: images above load after the first jump and push the
      // target down, so jump (and unfold) once everything has loaded.
      addEventListener('load', () => location.hash && reveal(location.hash.slice(1), 'instant'));

      // Fold/unfold: <button data-expand="id"> shows #id and every [data-in="id"]; the arrow flips via CSS.
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-expand]');
        if (!b) return;
        const id = b.dataset.expand!, open = b.getAttribute('aria-expanded') !== 'true';
        document.querySelectorAll<HTMLElement>(`#${id}, [data-in="${id}"]`).forEach((el) => (el.hidden = !open));
        b.setAttribute('aria-expanded', String(open));
      });

      // Scroll-spy for every .page-toc (header section bar, year index, page indexes):
      // mark the last visible target whose top has passed 30% of the viewport.
      document.querySelectorAll<HTMLElement>('.page-toc').forEach((toc) => {
        const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[data-toc]')];
        const targets = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
        if (!targets.length) return;
        const update = () => {
          const cur = targets.filter((t) => t.offsetParent && t.getBoundingClientRect().top < innerHeight * 0.3).pop() ?? targets[0];
          links.forEach((a) => a.classList.toggle('toc-on', a.dataset.toc === cur?.id));
        };
        addEventListener('scroll', update, { passive: true }); update();
      });

      // Scroll-reveal: play once when an element enters the viewport (CSS in global.css).
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -10%' });
      document.querySelectorAll('.reveal, [data-stagger]').forEach((el) => io.observe(el));
    </script>

    <main class="flex-1"><slot /></main>

    <footer class="bg-ink text-slate-300">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 md:flex-row md:items-center md:justify-between lg:px-8">
        <div class="flex items-center gap-4">
          <Logo class="h-9" />
          <div>
            <p class="font-bold text-white">{SITE.fullName}</p>
            <p class="text-sm">{SITE.department && `${SITE.department}, `}{SITE.affiliationFull}</p>
          </div>
        </div>
        <div class="text-sm md:text-right">
          <p>{SITE.address}</p>
          <a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a>
          {SITE.github && <> · <a href={SITE.github} class="hover:text-white">GitHub</a></>}
        </div>
      </div>
      <p class="border-t border-slate-700 py-4 text-center text-xs text-slate-500">© {new Date().getFullYear()} {SITE.name}, {SITE.affiliation}</p>
    </footer>
  </body>
</html>
