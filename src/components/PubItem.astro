---
// One publication entry. Used on /publications, /professor and the home page.
const { p, id } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = p.doi ? `https://doi.org/${p.doi}` : p.link;
const pdf = p.pdf && (p.pdf.startsWith('http') ? p.pdf : `${base}${p.pdf}`);
// BibTeX: authors "A, B, C*" → "A and B and C"; markers *† stripped.
const entry = { journal: 'article', conference: 'inproceedings', patent: 'misc', book: 'incollection' }[p.type];
const field = { journal: 'journal', conference: 'booktitle', patent: 'howpublished', book: 'booktitle' }[p.type];
const bib = `@${entry}{${id},\n  title = {${p.title}},\n  author = {${p.authors.replace(/[*†]/g, '').split(/,\s*/).join(' and ')}},\n  ${field} = {${p.venue}},\n  year = {${p.year}}${p.volume ? `,\n  note = {${p.volume}}` : ''}${p.doi ? `,\n  doi = {${p.doi}}` : ''}\n}`;
const btn = 'rounded px-2 py-0.5 text-xs font-semibold';
---
<li class="pub border-l-4 border-sky pl-4">
  <p class="font-medium">{href ? <a href={href} class="hover:underline">{p.title}</a> : p.title}</p>
  <p class="text-sm text-slate-600 dark:text-slate-300">{p.authors}</p>
  <p class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
    <span><em>{p.venue}</em>{p.volume && `, ${p.volume}`} ({p.year})</span>
    {href && <a href={href} class:list={[btn, 'bg-blue text-white']}>{p.doi ? 'DOI' : 'LINK'}</a>}
    {pdf && <a href={pdf} class:list={[btn, 'bg-slate-600 text-white']}>PDF</a>}
    <button type="button" class:list={[btn, 'copy-bib border border-slate-300 hover:bg-slate-100 dark:border-slate-600 dark:hover:bg-slate-800']} data-bib={bib}>BibTeX</button>
  </p>
</li>
<script>
  // Copy BibTeX to clipboard; button text flashes "Copied".
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-bib');
    if (!b) return;
    await navigator.clipboard.writeText(b.dataset.bib!);
    b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'BibTeX'), 1200);
  });
</script>
