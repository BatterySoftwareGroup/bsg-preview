---
// BSG mark: final logo boxes/colors (디자인쏘다, 2026-11) with letters retouched in SUIT ExtraBold —
// b reaches the top edge, g the bottom edge (docs/logo-suit-retouch.png, variant D). Height via class.
const { class: cls = 'h-8' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<img src={`${base}/logo/bsg-mark-light.png`} alt="BSG · Battery Software Group" class={`w-auto ${cls}`} />
